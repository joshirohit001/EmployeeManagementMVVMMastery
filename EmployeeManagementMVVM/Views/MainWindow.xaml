<Window x:Class="EmployeeManagementMVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Management System"
        Height="850" Width="1350"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#172554" Padding="22,16">
            <StackPanel>
                <TextBlock Text="Employee Management System"
                           FontSize="25" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="WPF • MVVM • SQL Server • Entity Framework Core"
                           Margin="0,5,0,0" Foreground="#CBD5E1"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Employees.Count}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Padding="18" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Employee Details" FontSize="19"
                                   FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="First Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Last Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Gender" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,12">
                            <RadioButton Content="Male" GroupName="Gender"
                                         IsChecked="{Binding IsMale, Mode=TwoWay}" Margin="0,0,18,0"/>
                            <RadioButton Content="Female" GroupName="Gender"
                                         IsChecked="{Binding IsFemale, Mode=TwoWay}" Margin="0,0,18,0"/>
                            <RadioButton Content="Other" GroupName="Gender"
                                         IsChecked="{Binding IsOther, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Departments}"
                                  SelectedItem="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="False"/>

                        <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Cities}"
                                  SelectedItem="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DateOfBirth}"/>

                        <TextBlock Text="Joining Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding JoiningDate}"/>

                        <TextBlock Text="Monthly Salary" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Salary, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Experience (Years)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ExperienceYears, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Skills (select multiple)" Style="{StaticResource FieldLabel}"/>
                        <ListBox x:Name="SkillsListBox" ItemsSource="{Binding AvailableSkills}"
                                 SelectionMode="Multiple" Height="105"
                                 SelectionChanged="SkillsListBox_SelectionChanged"
                                 Margin="0,5,0,10"/>

                        <CheckBox Content="Active Employee" IsChecked="{Binding IsActive}"
                                  Margin="0,3,0,8"/>
                        <CheckBox Content="Permanent Employee" IsChecked="{Binding IsPermanent}"
                                  Margin="0,3,0,14"/>

                        <WrapPanel>
                            <Button Content="Save Employee" Background="#2563EB"
                                    Foreground="White" Command="{Binding SaveCommand}"/>
                            <Button Content="Clear" Command="{Binding ClearCommand}"/>
                        </WrapPanel>
                        <Button Content="Delete Selected Employee" Margin="0,10,0,0"
                                Background="#FEE2E2" Foreground="#991B1B"
                                Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Employee Records" FontSize="19"
                                   FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,8,0"
                                     ToolTip="Search by name, email or department"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Search"
                                    Command="{Binding SearchCommand}"/>
                            <Button Grid.Column="2" Content="Refresh"
                                    Command="{Binding RefreshCommand}"/>
                        </Grid>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FilteredEmployees}"
                              SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*"/>
                            <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*"/>
                            <DataGridTextColumn Header="Salary" Binding="{Binding Salary, StringFormat=N2}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
